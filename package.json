{
  "name": "@aiwayds/dsh-llm-proxy",
  "version": "0.1.0",
  "description": "dsh plugin: SYSTEM proxy (env) + LLM traffic-splitting proxy via a process-global undici routing dispatcher",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "keywords": [
    "dsh",
    "plugin",
    "proxy",
    "undici",
    "deepseek-harness",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fan56/dsh-llm-proxy.git"
  },
  "homepage": "https://github.com/fan56/dsh-llm-proxy",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test test/match.test.mjs test/router.test.mjs test/config.test.mjs test/dispose.test.mjs"
  },
  "dependencies": {
    "undici": "8.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "fliu56",
  "publishConfig": {
    "access": "public"
  }
}
